# AI agentlar uchun manifestlar — har doim JSON, hech qachon HTML emas.
# Content-Type shu yerda majburiy belgilanadi, shuning uchun SPA fallback
# (index.html) bu yo'llarga ta'sir qilmaydi.

/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Sayt kodi tez yangilanishi uchun: brauzer har safar ETag bilan qayta
# tekshiradi (o'zgarmagan bo'lsa 304, tarmoq trafigi deyarli yo'q).
/effects.js
  Cache-Control: public, max-age=0, must-revalidate

/visits.js
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/alifbo-core.js
  Cache-Control: public, max-age=0, must-revalidate

/zip-lite.js
  Cache-Control: public, max-age=0, must-revalidate

/convert.js
  Cache-Control: public, max-age=0, must-revalidate
